# ============================================================================
# ShowKart environment variables — copy this file to `.env` and fill in.
# Never commit `.env` to git.
# ============================================================================

# --- Postgres ---
# Superuser credentials for the local Postgres instance; per-service
# connection URLs are derived by services in later stories.
POSTGRES_USER=showkart
POSTGRES_PASSWORD=change-me-in-local

# --- Grafana ---
# Initial admin login for local Grafana at http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-local

# --- Gateway ---
# Host port to expose the API Gateway on
GATEWAY_PORT=8080

# --- Auth Service ---
# Host port to expose Auth Service on
AUTH_SERVICE_PORT=8081

# HS256 signing secret for JWTs. MUST be >= 32 bytes (256 bits).
# Generate a fresh one for every environment, e.g.:
#   openssl rand -base64 48
# The value below is DEV ONLY; never reuse in staging or production.
AUTH_JWT_SECRET=dev-only-do-not-reuse-in-prod-please-rotate-me-immediately-32b+
AUTH_JWT_ACCESS_TTL_SECONDS=3600
AUTH_REFRESH_TTL_SECONDS=604800
